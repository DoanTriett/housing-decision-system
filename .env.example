# Copy this file to apps/api/.env and adjust values for local development.
# Never commit the actual .env file.

ENVIRONMENT=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/housing
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333
LOG_LEVEL=INFO
VOYAGE_API_KEY=your-voyage-api-key-here
OPENAI_API_KEY=your-openai-api-key-here
GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here
PLANNER_MODEL=gpt-4.1-mini
SPECIALIST_MODEL=gpt-4.1-mini
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
SSE_CHANNEL_PREFIX=run_progress

# Clerk auth - from Clerk Dashboard -> API Keys / JWT templates.
# For local smoke without a Clerk project, set CLERK_JWKS_URL=local and use
# scripts/make_dev_token.py to mint HS256 tokens signed with DEV_JWT_SECRET.
CLERK_JWKS_URL=local
CLERK_ISSUER=http://localhost/clerk
DEV_JWT_SECRET=local-dev-only-not-for-production
RATE_LIMIT_PER_USER_PER_HOUR=20

# LangSmith (optional - leave false/blank to disable tracing)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=housing-decision-system

# Production CORS (comma-separated frontend origins)
CORS_ORIGINS=
